---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import Pagination from '../../components/Pagination.astro';
import CategoryChips from '../../components/CategoryChips.astro';
import Footer from '../../components/Footer.astro';
import { cmsEnv, getSettings, getServices, getCases, getCategories } from '../../lib/cms';

export const prerender = false;

const pageParam = Astro.params.page;
const pageNum = pageParam ? Number(pageParam) : 1;
if (!Number.isInteger(pageNum) || pageNum < 1) return Astro.rewrite('/404');

const activeCategory = Astro.url.searchParams.get('category') ?? undefined;
const query = activeCategory ? `?category=${encodeURIComponent(activeCategory)}` : '';

const env = cmsEnv();
const [settings, services, categories, result] = await Promise.all([
  getSettings(env),
  getServices(env),
  getCategories(env),
  getCases(env, pageNum, activeCategory),
]);
if (result && pageNum > 1 && result.docs.length === 0) return Astro.rewrite('/404');
// CMS unreachable: temporary condition — show an empty state, not a 404
if (!result) Astro.response.status = 503;

const docs = result?.docs ?? [];
const page = {
  currentPage: result?.page ?? 1,
  lastPage: result?.totalPages ?? 1,
  url: {
    prev: result?.hasPrevPage ? (result.page === 2 ? `/cases${query}` : `/cases/${result.page - 1}${query}`) : undefined,
    next: result?.hasNextPage ? `/cases/${result.page + 1}${query}` : undefined,
  },
};
---

<Base
  title="Виграні справи — АБ «Марина В.Г. Юридичний захист»"
  description="Приклади виграних справ адвоката в Ужгороді: кримінальні, митні, цивільні та адміністративні провадження."
  settings={settings}
  services={services}
>
  <Header phone={settings.phone} phoneHref={settings.phoneHref} />
  <main>
    <PageHero
      eyebrow="Практика в судах"
      title="Виграні справи"
      lead="Реальні результати роботи бюро: закриті провадження, повернуте майно та стягнуті виплати."
    />

    <section class="bg-porcelain py-20">
      <CategoryChips categories={categories} active={activeCategory} base="/cases" />
      <div class="mx-auto grid max-w-7xl gap-6 px-4 sm:px-6 md:grid-cols-2 xl:grid-cols-3">
        {
          docs.map((c) => (
            <article class="reveal group flex flex-col border-t-2 border-gold-500 bg-white p-8 shadow-sm transition-shadow hover:shadow-lg">
              {c.category && (
                <p class="mb-4 text-xs font-bold tracking-wide uppercase">
                  <a href={`/cases?category=${c.category.slug}`} class="text-gold-500 transition-colors hover:text-gold-400">
                    {c.category.title}
                  </a>
                </p>
              )}
              <h2 class="display text-2xl leading-snug text-ink-900">
                <a href={`/cases/${c.slug}`} class="transition-colors group-hover:text-gold-500">
                  {c.title}
                </a>
              </h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{c.description}</p>
              <p class="mt-6 flex items-center gap-2 border-t border-porcelain pt-4 text-sm font-bold text-ink-900">
                <svg class="h-4 w-4 text-gold-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M4 12l5 5L20 7" />
                </svg>
                {c.result}
              </p>
              <a
                href={`/cases/${c.slug}`}
                class="mt-4 inline-flex items-center gap-2 text-xs font-bold tracking-[0.2em] text-gold-500 uppercase"
              >
                Детальніше
                <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M2 8h11M9 4l4 4-4 4" />
                </svg>
              </a>
            </article>
          ))
        }
      </div>
      {
        docs.length === 0 && (
          <p class="mx-auto max-w-xl px-4 text-center text-muted">
            {result
              ? 'У цій категорії поки немає матеріалів.'
              : 'Матеріали тимчасово недоступні. Оновіть сторінку за кілька хвилин або зателефонуйте нам — контакти внизу сторінки.'}
          </p>
        )
      }
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <Pagination page={page} base="/cases" query={query} />
      </div>

      <div class="mx-auto mt-14 max-w-7xl px-4 text-center sm:px-6">
        <a
          href="/#contact"
          data-consult
          class="inline-block rounded-sm bg-gold-500 px-8 py-4 text-sm font-bold tracking-wide text-ink-950 uppercase transition-colors hover:bg-gold-400"
        >
          Обговорити вашу справу
        </a>
      </div>
    </section>
  </main>
  <Footer settings={settings} />
</Base>
