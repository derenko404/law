---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import Pagination from '../../components/Pagination.astro';
import Footer from '../../components/Footer.astro';
import { cmsEnv, getSettings, getServices, getArticles } from '../../lib/cms';

export const prerender = false;

const pageParam = Astro.params.page;
const pageNum = pageParam ? Number(pageParam) : 1;
if (!Number.isInteger(pageNum) || pageNum < 1) return Astro.rewrite('/404');

const env = cmsEnv();
const [settings, services, result] = await Promise.all([
  getSettings(env),
  getServices(env),
  getArticles(env, pageNum),
]);
if (result && pageNum > 1 && result.docs.length === 0) return Astro.rewrite('/404');
// CMS unreachable: temporary condition — show an empty state, not a 404
if (!result) Astro.response.status = 503;

const docs = result?.docs ?? [];
const page = {
  currentPage: result?.page ?? 1,
  lastPage: result?.totalPages ?? 1,
  url: {
    prev: result?.hasPrevPage ? (result.page === 2 ? '/articles' : `/articles/${result.page - 1}`) : undefined,
    next: result?.hasNextPage ? `/articles/${result.page + 1}` : undefined,
  },
};

const fmt = new Intl.DateTimeFormat('uk-UA', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base
  title="Статті адвоката — АБ «Марина В.Г. Юридичний захист»"
  description="Практичні юридичні поради від адвоката в Ужгороді: митні справи, адміністративні штрафи, сімейне та кримінальне право."
  settings={settings}
  services={services}
>
  <Header phone={settings.phone} phoneHref={settings.phoneHref} />
  <main>
    <PageHero
      eyebrow="Блог"
      title="Статті адвоката"
      lead="Практичні поради з реальних справ: що робити, які строки не пропустити та коли час звертатися до адвоката."
    />

    <section class="bg-porcelain py-20">
      <div class="mx-auto grid max-w-7xl gap-6 px-4 sm:px-6 md:grid-cols-2 xl:grid-cols-3">
        {
          docs.map((article) => (
            <article class="reveal group flex flex-col border-t-2 border-gold-500 bg-white p-8 shadow-sm transition-shadow hover:shadow-lg">
              <div class="mb-4 flex items-center gap-3 text-xs font-bold tracking-wide text-muted uppercase">
                <time datetime={article.publishedAt}>{fmt.format(new Date(article.publishedAt))}</time>
                {article.category && (
                  <>
                    <span class="h-1 w-1 rounded-full bg-gold-500" />
                    <span class="text-gold-500">{article.category}</span>
                  </>
                )}
              </div>
              <h2 class="display text-2xl leading-snug text-ink-900">
                <a href={`/articles/${article.slug}`} class="transition-colors group-hover:text-gold-500">
                  {article.title}
                </a>
              </h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{article.description}</p>
              <a
                href={`/articles/${article.slug}`}
                class="mt-6 inline-flex items-center gap-2 text-xs font-bold tracking-[0.2em] text-gold-500 uppercase"
              >
                Читати далі
                <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M2 8h11M9 4l4 4-4 4" />
                </svg>
              </a>
            </article>
          ))
        }
      </div>
      {
        docs.length === 0 && (
          <p class="mx-auto max-w-xl px-4 text-center text-muted">
            Матеріали тимчасово недоступні. Оновіть сторінку за кілька хвилин або
            зателефонуйте нам — контакти внизу сторінки.
          </p>
        )
      }
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <Pagination page={page} base="/articles" />
      </div>
    </section>
  </main>
  <Footer settings={settings} />
</Base>
