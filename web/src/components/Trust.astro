---
import SectionHeading from './SectionHeading.astro';
import Emblem from './Emblem.astro';
import { site } from '../data/site';
import { credentials } from '../data/content';
import type { CmsCase } from '../lib/cms';

/**
 * Trust block: bar certificate, experience and the latest won cases.
 * The certificate card hides until `site.certificate.number` is filled in;
 * the cases row hides when the CMS has no cases (or is unreachable).
 */
interface Props {
  cases: CmsCase[];
}
const { cases } = Astro.props;
const { certificate } = site;
---

<section id="trust" class="bg-porcelain py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionHeading eyebrow="Чому нам довіряють" title="Досвід, підтверджений документами" />

    <div class:list={['reveal grid gap-6', certificate.number ? 'lg:grid-cols-2' : 'mx-auto max-w-3xl']}>
      {
        certificate.number && (
          <div class="relative overflow-hidden bg-ink-950 p-8 sm:p-10">
            <div class="pointer-events-none absolute -right-14 -bottom-14 text-gold-500/10">
              <Emblem class="h-56 w-56" />
            </div>
            <p class="text-xs font-bold tracking-[0.3em] text-gold-400 uppercase">
              Свідоцтво адвоката
            </p>
            <p class="display mt-4 text-4xl text-white">№ {certificate.number}</p>
            <p class="mt-3 text-sm leading-relaxed text-white/65">
              Про право на заняття адвокатською діяльністю. Видане{certificate.issuedAt && <> {certificate.issuedAt} року</>}{' '}
              {certificate.issuedBy}.
            </p>
          </div>
        )
      }

      <div class="bg-white p-8 shadow-sm sm:p-10">
        <p class="text-xs font-bold tracking-[0.3em] text-gold-500 uppercase">Стаж і статус</p>
        <ul class="mt-6 space-y-5">
          {
            credentials.map((c) => (
              <li class="flex gap-4 leading-relaxed text-body">
                <span class="mt-3 h-px w-8 shrink-0 bg-gold-500" />
                {c}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {
      cases.length > 0 && (
        <div class="mt-14">
          <h3 class="display mb-6 text-center text-3xl text-ink-900">Приклади виграних справ</h3>
          <div class="grid gap-6 md:grid-cols-3">
            {cases.map((c) => (
              <a
                href={`/cases/${c.slug}`}
                class="reveal group flex flex-col border-t-2 border-gold-500 bg-white p-7 shadow-sm transition-shadow hover:shadow-lg"
              >
                {c.category && (
                  <p class="mb-3 text-xs font-bold tracking-wide text-gold-500 uppercase">
                    {c.category.title}
                  </p>
                )}
                <h4 class="display text-xl leading-snug text-ink-900 transition-colors group-hover:text-gold-500">
                  {c.title}
                </h4>
                {c.result && (
                  <p class="mt-4 flex gap-2 text-sm leading-relaxed text-body">
                    <span class="font-bold text-gold-500">Результат:</span>
                    {c.result}
                  </p>
                )}
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>
