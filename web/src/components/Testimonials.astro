---
import SectionHeading from './SectionHeading.astro';
import { testimonials, clients } from '../data/content';
---

<section id="testimonials" class="bg-porcelain py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionHeading eyebrow="Довіра" title="Відгуки клієнтів" />

    <div class="grid gap-6 md:grid-cols-3">
      {
        testimonials.map((t) => (
          <figure class="reveal flex flex-col bg-white p-8 shadow-sm">
            <span class="display text-6xl leading-none text-gold-500" aria-hidden="true">
              «
            </span>
            <blockquote class="flex-1 text-sm leading-relaxed text-body">{t.text}</blockquote>
            <figcaption class="mt-6 border-t border-porcelain pt-4 text-sm font-bold text-ink-900">
              {t.author}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="reveal mt-16 text-center">
      <p class="mb-5 text-xs font-bold tracking-[0.3em] text-muted uppercase">Наші довірителі</p>
      <ul class="mx-auto flex max-w-4xl flex-wrap items-center justify-center gap-x-8 gap-y-3">
        {
          clients.map((c) => (
            <li class="display text-lg text-ink-700/70">{c}</li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
