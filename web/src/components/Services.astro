---
import SectionHeading from './SectionHeading.astro';
import { services, extraAreas } from '../data/services';

const icons: Record<string, string> = {
  shield:
    'M12 3l7 3v5c0 4.4-3 8.4-7 9.5C8 19.4 5 15.4 5 11V6l7-3z',
  gavel:
    'M13.5 4.5l6 6-2 2-6-6 2-2zM11 7l6 6-7.5 7.5H4v-5.5L11 7zM3 21h12v-1.5H3V21z',
  scale:
    'M12 3v18M5 7h14M7 7l-3 6c0 1.7 1.6 3 3.5 3S11 14.7 11 13L8 7M17 7l-3 6c0 1.7 1.6 3 3.5 3s3.5-1.3 3.5-3l-3-6M8 21h8',
  family:
    'M9 8a3 3 0 100-6 3 3 0 000 6zm8 1a2.5 2.5 0 100-5 2.5 2.5 0 000 5zM3 21v-5a4 4 0 014-4h4a4 4 0 014 4v5m2 0v-4a3 3 0 013-3',
  customs:
    'M4 20h16M6 20V9l6-5 6 5v11M10 20v-6h4v6',
  land:
    'M3 21h18M5 21V11l5-4v14M14 21V7l5 4v10M8 14h1m5-2h1',
  briefcase:
    'M4 8h16a1 1 0 011 1v10a1 1 0 01-1 1H4a1 1 0 01-1-1V9a1 1 0 011-1zm5 0V6a2 2 0 012-2h2a2 2 0 012 2v2M3 13h18',
  contract:
    'M7 3h8l4 4v14H7a1 1 0 01-1-1V4a1 1 0 011-1zm8 0v4h4M10 12h6m-6 4h6m-6-8h2',
};
---

<section id="services" class="bg-porcelain py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionHeading
      eyebrow="Практика"
      title="Послуги адвоката в Ужгороді"
    />

    <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {
        services.map((s) => (
          <article class="reveal group flex flex-col border-t-2 border-gold-500 bg-white p-7 shadow-sm transition-shadow hover:shadow-lg">
            <svg
              class="mb-5 h-9 w-9 text-gold-500"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={icons[s.icon]} />
            </svg>
            <h3 class="display text-2xl text-ink-900">{s.title}</h3>
            <ul class="mt-4 flex-1 space-y-2">
              {s.points.map((p) => (
                <li class="flex gap-2 text-sm leading-relaxed text-muted">
                  <span class="mt-1.5 h-1 w-3 shrink-0 bg-gold-500" />
                  {p}
                </li>
              ))}
            </ul>
            {s.priceFrom && (
              <p class="mt-6 flex items-baseline justify-between border-t border-porcelain pt-4 text-sm text-muted">
                Консультація
                <span class="font-bold text-ink-900">від {s.priceFrom} грн</span>
              </p>
            )}
            <a
              href="/#contact"
              data-consult
              data-service={s.id}
              class="mt-4 block rounded-sm border border-gold-500 py-3 text-center text-sm font-bold text-gold-500 transition-colors group-hover:bg-gold-500 group-hover:text-ink-950"
            >
              Замовити консультацію
            </a>
          </article>
        ))
      }
    </div>

    <div class="reveal mt-12 text-center">
      <p class="mb-4 text-xs font-bold tracking-[0.3em] text-muted uppercase">
        Також працюємо у сферах
      </p>
      <ul class="mx-auto flex max-w-4xl flex-wrap justify-center gap-2">
        {
          extraAreas.map((a) => (
            <li class="rounded-full border border-ink-700/15 bg-white px-4 py-1.5 text-sm text-body">
              {a}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
