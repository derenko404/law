---
import Logo from './Logo.astro';
import { getContactLinks } from '../lib/contacts';
import { phoneIcon, socialIcons } from '../lib/icons';
import type { SiteSettings } from '../lib/cms';

interface Props {
  settings: Pick<SiteSettings, 'phone' | 'phoneHref' | 'phone2' | 'phone2Href' | 'socials' | 'hours'>;
}
const { settings } = Astro.props;
const contacts = getContactLinks(settings);
const messengers = [
  { label: 'Viber', href: contacts.viber, icon: socialIcons.viber, color: 'hover:bg-[#7360f2]' },
  { label: 'Telegram', href: contacts.telegram, icon: socialIcons.telegram, color: 'hover:bg-[#229ed9]' },
  { label: 'WhatsApp', href: contacts.whatsapp, icon: socialIcons.whatsapp, color: 'hover:bg-[#25d366]' },
];

const nav = [
  { href: '/#services', label: 'Послуги' },
  { href: '/#about', label: 'Про адвоката' },
  { href: '/cases', label: 'Виграні справи' },
  { href: '/articles', label: 'Статті' },
  { href: '/#contact', label: 'Контакти' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-gold-500/25 bg-ink-950/95 backdrop-blur">
  <!-- Contact strip: phone + messengers always visible at the very top (tap-to-call on mobile) -->
  <div class="border-b border-white/10 bg-ink-900" data-track-area="header">
    <div class="mx-auto flex h-10 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
      <p class="hidden truncate text-xs text-white/55 md:block">{settings.hours}</p>
      <div class="flex w-full items-center justify-between gap-2 md:w-auto md:justify-end">
        <div class="flex items-center gap-5">
          <a
            href={contacts.phoneHref}
            class="flex items-center gap-1.5 text-[13px] font-bold whitespace-nowrap text-gold-200 transition-colors hover:text-gold-400 sm:gap-2 sm:text-sm"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={phoneIcon} /></svg>
            {contacts.phone}
          </a>
          {
            settings.phone2 && (
              <a
                href={settings.phone2Href}
                class="hidden items-center gap-2 text-sm font-bold whitespace-nowrap text-gold-200 transition-colors hover:text-gold-400 lg:flex"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={phoneIcon} /></svg>
                {settings.phone2}
              </a>
            )
          }
        </div>
        <div class="flex items-center gap-1.5 sm:gap-2">
          {
            messengers.map((m) => (
              <a
                href={m.href}
                target="_blank"
                rel="noopener"
                aria-label={`Написати у ${m.label}`}
                class:list={[
                  'flex h-8 min-w-8 items-center justify-center gap-1.5 rounded-full border border-gold-500/40 px-1.5 text-xs sm:px-2.5 font-bold text-gold-200 transition-colors hover:border-transparent hover:text-white',
                  m.color,
                ]}
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={m.icon} /></svg>
                <span class="hidden sm:inline">{m.label}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto flex h-16 sm:h-20 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6">
    <Logo tone="light" />

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Основна навігація">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-sm font-semibold text-white/80 transition-colors hover:text-gold-400"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-4">
      <a
        href="/#contact"
        data-consult
        class="hidden rounded-sm bg-gold-500 px-5 py-2.5 text-sm font-bold text-ink-950 transition-colors hover:bg-gold-400 sm:block"
      >
        Отримати консультацію
      </a>
      <button
        id="menu-toggle"
        class="flex h-10 w-10 items-center justify-center text-white lg:hidden"
        aria-label="Меню"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-gold-500/25 bg-ink-950 lg:hidden">
    <nav class="flex flex-col px-6 py-4" aria-label="Мобільна навігація">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="border-b border-white/5 py-3 text-sm font-semibold text-white/85 last:border-0"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/#contact"
        data-consult
        class="mt-4 rounded-sm bg-gold-500 px-5 py-3 text-center text-sm font-bold text-ink-950"
      >
        Отримати консультацію
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    }),
  );
</script>
