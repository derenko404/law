---
import ConsultForm from './ConsultForm.astro';

interface Props {
  services?: { id: string; title: string }[];
  phone?: string;
}
const { services, phone } = Astro.props;
---

<dialog
  id="consult-modal"
  class="m-auto w-[calc(100%-2rem)] max-w-xl bg-porcelain p-0 shadow-2xl backdrop:bg-ink-950/70 backdrop:backdrop-blur-sm"
>
  <div class="border-t-2 border-gold-500 p-8 sm:p-10">
    <div class="mb-6 flex items-start justify-between gap-4">
      <div>
        <p class="mb-2 text-xs font-bold tracking-[0.3em] text-gold-500 uppercase">Звʼязок</p>
        <h2 class="display text-3xl text-ink-900">Замовити консультацію</h2>
      </div>
      <button
        type="button"
        class="modal-close -mt-1 flex h-10 w-10 shrink-0 items-center justify-center text-muted transition-colors hover:text-ink-900"
        aria-label="Закрити"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
    <ConsultForm idPrefix="modal" services={services} phone={phone} />
  </div>
</dialog>
