---
import SectionHeading from './SectionHeading.astro';
import Emblem from './Emblem.astro';
import ConsultForm from './ConsultForm.astro';
import { site, socials } from '../data/site';

const socialIcons: Record<string, string> = {
  facebook:
    'M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.2-1.5 1.5-1.5h1.4V4.9c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8V11H8v3h2.5v7h3z',
  instagram:
    'M12 8.4A3.6 3.6 0 1012 15.6 3.6 3.6 0 0012 8.4zm0 5.9a2.3 2.3 0 110-4.6 2.3 2.3 0 010 4.6zM17 6.1a.9.9 0 11-1.8 0 .9.9 0 011.8 0zM21 12c0-2.4 0-4.1-.5-5.3a4.6 4.6 0 00-2.7-2.7C16.6 3.5 14.9 3.5 12.5 3.5h-1c-2.4 0-4.1 0-5.3.5a4.6 4.6 0 00-2.7 2.7C3 7.9 3 9.6 3 12s0 4.1.5 5.3a4.6 4.6 0 002.7 2.7c1.2.5 2.9.5 5.3.5h1c2.4 0 4.1 0 5.3-.5a4.6 4.6 0 002.7-2.7c.5-1.2.5-2.9.5-5.3zm-1.9 0c0 2.3 0 3.7-.4 4.6a3 3 0 01-1.7 1.7c-.9.4-2.3.4-4.6.4h-.8c-2.3 0-3.7 0-4.6-.4a3 3 0 01-1.7-1.7c-.4-.9-.4-2.3-.4-4.6v-.8c0-2.3 0-3.7.4-4.6a3 3 0 011.7-1.7c.9-.4 2.3-.4 4.6-.4h.8c2.3 0 3.7 0 4.6.4a3 3 0 011.7 1.7c.4.9.4 2.3.4 4.6v.8z',
  telegram:
    'M21 5.1L17.9 19c-.2.9-.8 1.1-1.6.7l-4.4-3.2-2.1 2c-.2.2-.4.4-.9.4l.3-4.4L17.3 7c.4-.3-.1-.5-.6-.2l-9.9 6.2-4.3-1.3c-.9-.3-.9-.9.2-1.3L19.8 4c.8-.3 1.5.2 1.2 1.1z',
  viber:
    'M12.1 3C10 3 6.4 3.4 4.6 5.1 3.3 6.3 3 8.2 3 10.4c0 2.2.2 4.1 1.5 5.4.5.5 1.2.9 2 1.2v2.4c0 .5.6.8 1 .4l1.9-2c.9.1 1.8.1 2.6.1 2.2 0 5.7-.4 7.5-2.1 1.3-1.3 1.5-3.2 1.5-5.4 0-2.2-.3-4.1-1.6-5.3C17.7 3.4 14.2 3 12.1 3zm3.6 11.5c-.3.3-.7.4-1 .2-1.1-.5-2.2-1.2-3.1-2.1-.9-.9-1.6-2-2.1-3.1-.2-.4 0-.8.3-1l.7-.6c.3-.2.7-.2.9.1l.8 1.1c.2.3.2.6-.1.9l-.3.4c.3.6.8 1.2 1.3 1.7s1.1.9 1.7 1.3l.4-.4c.2-.2.6-.3.9-.1l1.1.8c.3.2.3.7.1.9l-.6.9z',
  whatsapp:
    'M12 3a9 9 0 00-7.8 13.5L3 21l4.6-1.2A9 9 0 1012 3zm4.4 12.6c-.2.5-1 1-1.5 1.1-.4.1-.9.1-1.4-.1-.3-.1-.8-.2-1.4-.5-2.4-1-4-3.4-4.1-3.6-.1-.2-1-1.3-1-2.5s.6-1.8.8-2c.2-.2.5-.3.7-.3h.5c.2 0 .4-.1.6.4l.9 2.1c.1.2.1.4 0 .6l-.4.6-.3.4c-.1.1-.2.3-.1.5.1.2.6 1 1.3 1.6.9.8 1.7 1.1 2 1.2.2.1.4.1.5-.1l.7-.9c.2-.2.4-.2.6-.1l2 .9c.2.1.4.2.4.3 0 .1 0 .7-.2 1.2z',
};
---

<section id="contact" class="relative bg-white py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionHeading
      eyebrow="Звʼязок"
      title="Замовити консультацію адвоката"
    />

    <div class="reveal grid overflow-hidden shadow-xl lg:grid-cols-5">
      <!-- Info panel -->
      <div class="relative overflow-hidden bg-ink-950 p-10 lg:col-span-2">
        <div class="pointer-events-none absolute -bottom-20 -left-20 text-gold-500/10">
          <Emblem class="h-80 w-80" />
        </div>
        <h3 class="display text-2xl text-white">{site.name}</h3>
        <p class="mt-3 text-sm leading-relaxed text-white/60">
          Заповніть форму — і ми звʼяжемося з вами найближчим часом.
          Конфіденційність гарантована.
        </p>

        <ul class="relative mt-10 space-y-6 text-sm">
          <li class="flex items-center gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-gold-500/40 text-gold-400">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 00-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 00-7-7zm0 9.5A2.5 2.5 0 1112 6.5a2.5 2.5 0 010 5z"/></svg>
            </span>
            <a
              href={site.mapUrl}
              target="_blank"
              rel="noopener"
              class="text-white/80 transition-colors hover:text-gold-400"
            >
              {site.address}
            </a>
          </li>
          <li class="flex items-center gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-gold-500/40 text-gold-400">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
            </span>
            <a href={site.phoneHref} class="font-bold text-white transition-colors hover:text-gold-400">{site.phone}</a>
          </li>
          <li class="flex items-center gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-gold-500/40 text-gold-400">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4a2 2 0 00-2 2v12a2 2 0 002 2h16a2 2 0 002-2V6a2 2 0 00-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            </span>
            <a href={`mailto:${site.email}`} class="text-white/80 transition-colors hover:text-gold-400">{site.email}</a>
          </li>
          <li class="flex items-center gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-gold-500/40 text-gold-400">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm4 11h-5V6h1.5v5.5H16V13z"/></svg>
            </span>
            <span class="text-white/80">{site.hours}</span>
          </li>
        </ul>

        <div class="relative mt-10 flex gap-3">
          {
            socials.map((s) => (
              <a
                href={s.href}
                aria-label={s.name}
                class="flex h-9 w-9 items-center justify-center rounded-full border border-gold-500/40 text-gold-200 transition-colors hover:border-gold-400 hover:text-gold-400"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={socialIcons[s.icon]} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Form -->
      <div class="bg-porcelain p-10 lg:col-span-3">
        <ConsultForm idPrefix="contact" />
      </div>
    </div>
  </div>
</section>
