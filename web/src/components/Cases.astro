---
import SectionHeading from './SectionHeading.astro';
import { caseCategories } from '../data/content';
---

<section id="cases" class="bg-ink-950 py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <SectionHeading tone="light" eyebrow="Практика в судах" title="Виграні справи" />

    <div class="grid gap-px overflow-hidden border border-gold-500/20 bg-gold-500/20 sm:grid-cols-2 lg:grid-cols-3">
      {
        caseCategories.map((c) => (
          <a
            href="/#contact"
            data-consult
            class="reveal group bg-ink-950 p-8 transition-colors hover:bg-ink-900"
          >
            <h3 class="display text-2xl text-white transition-colors group-hover:text-gold-400">
              {c.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-white/55">{c.note}</p>
            <span class="mt-6 inline-flex items-center gap-2 text-xs font-bold tracking-[0.2em] text-gold-500 uppercase">
              Обговорити справу
              <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M2 8h11M9 4l4 4-4 4" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>

    <div class="reveal mt-10 text-center">
      <a
        href="/cases"
        class="inline-flex items-center gap-2 rounded-sm border border-gold-500/50 px-8 py-4 text-sm font-bold tracking-wide text-gold-200 uppercase transition-colors hover:border-gold-400 hover:text-gold-400"
      >
        Всі виграні справи
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M2 8h11M9 4l4 4-4 4" />
        </svg>
      </a>
    </div>
  </div>
</section>
