---
/**
 * Bureau emblem — vectorized from the original logo (potrace).
 * References the single path definition injected once per page by Base.astro
 * (id="emblem-p") to avoid duplicating the path data in the DOM.
 */
interface Props {
  class?: string;
}
const { class: className = 'h-10 w-10' } = Astro.props;
---

<svg viewBox="0 0 322 321" class={className} aria-hidden="true">
  <use href="#emblem-p"></use>
</svg>
