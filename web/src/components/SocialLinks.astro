---
import { socialIcons } from '../lib/icons';

/** Social-network icon links (dark sections: contact panel, footer). */
interface Props {
  socials: { icon: string; href: string }[];
  class?: string;
}
const { socials, class: className = '' } = Astro.props;

---

{
  socials.length > 0 && (
    <div class={`flex gap-3 ${className}`}>
      {socials.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener"
          aria-label={s.icon}
          class="flex h-9 w-9 items-center justify-center rounded-full border border-gold-500/40 text-gold-200 transition-colors hover:border-gold-400 hover:text-gold-400"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={socialIcons[s.icon] ?? ''} />
          </svg>
        </a>
      ))}
    </div>
  )
}
