---
import Logo from './Logo.astro';
import SocialLinks from './SocialLinks.astro';
import { site as fallbackMeta } from '../data/site';
import type { SiteSettings } from '../lib/cms';
import { getContactLinks } from '../lib/contacts';
import { phoneIcon, socialIcons } from '../lib/icons';

interface Props {
  settings: SiteSettings;
}
const { settings } = Astro.props;
const site = { ...fallbackMeta, ...settings };

const year = new Date().getFullYear();
const contacts = getContactLinks(settings);
---

<footer class="border-t border-gold-500/20 bg-ink-950 py-14">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 md:grid-cols-3">
    <div>
      <Logo tone="light" />
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/55">
        Якісні юридичні послуги в Ужгороді з гарантією професійності та
        конфіденційності.
      </p>
    </div>

    <nav class="text-sm" aria-label="Карта сайту">
      <p class="mb-4 text-xs font-bold tracking-[0.3em] text-gold-400 uppercase">Карта сайту</p>
      <ul class="space-y-2">
        <li><a href="/#services" class="text-white/70 transition-colors hover:text-gold-400">Послуги</a></li>
        <li><a href="/#about" class="text-white/70 transition-colors hover:text-gold-400">Про адвоката</a></li>
        <li><a href="/cases" class="text-white/70 transition-colors hover:text-gold-400">Виграні справи</a></li>
        <li><a href="/articles" class="text-white/70 transition-colors hover:text-gold-400">Статті</a></li>
        <li><a href="/#testimonials" class="text-white/70 transition-colors hover:text-gold-400">Відгуки</a></li>
        <li><a href="/#contact" class="text-white/70 transition-colors hover:text-gold-400">Контакти</a></li>
      </ul>
    </nav>

    <div class="text-sm">
      <p class="mb-4 text-xs font-bold tracking-[0.3em] text-gold-400 uppercase">Контакти</p>
      <ul class="space-y-4 text-white/70">
        <li class="flex items-center gap-3">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-gold-500/40 text-gold-400">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 00-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 00-7-7zm0 9.5A2.5 2.5 0 1112 6.5a2.5 2.5 0 010 5z"/></svg>
          </span>
          <a href={site.mapUrl} target="_blank" rel="noopener" class="transition-colors hover:text-gold-400">
            {site.address}
          </a>
        </li>
        <li class="flex items-center gap-3">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-gold-500/40 text-gold-400">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
          </span>
          <span class="flex flex-col gap-1">
                <a href={site.phoneHref} class="font-bold text-white transition-colors hover:text-gold-400">{site.phone}</a>
                {site.phone2 && <a href={site.phone2Href} class="font-bold text-white transition-colors hover:text-gold-400">{site.phone2}</a>}
              </span>
        </li>
        <li class="flex items-center gap-3">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-gold-500/40 text-gold-400">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4a2 2 0 00-2 2v12a2 2 0 002 2h16a2 2 0 002-2V6a2 2 0 00-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          </span>
          <a href={`mailto:${site.email}`} class="font-bold text-white transition-colors hover:text-gold-400">{site.email}</a>
        </li>
        <li class="pl-11">
          <a href={site.mapUrl} target="_blank" rel="noopener" class="text-gold-200 underline-offset-4 transition-colors hover:text-gold-400 hover:underline">
            Показати на карті
          </a>
        </li>
      </ul>
      <SocialLinks socials={site.socials} class="mt-6" />
    </div>
  </div>

  <div class="mx-auto mt-12 max-w-7xl border-t border-white/10 px-4 pt-6 text-xs text-white/60 sm:px-6">
    © {year} {site.name}. Всі права захищені.
  </div>
</footer>

<!-- Desktop: floating call button -->
<a
  href={site.phoneHref}
  aria-label="Зателефонувати"
  data-track-area="fab"
  class="fab-call fixed bottom-5 right-5 z-40 hidden h-14 w-14 items-center justify-center rounded-full bg-gold-500 text-ink-950 shadow-lg transition-colors hover:bg-gold-400 md:flex"
>
  <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={phoneIcon} /></svg>
</a>

<!-- Mobile: sticky tap-to-call + messenger bar (spacer keeps the footer above it) -->
<div class="h-16 md:hidden" aria-hidden="true"></div>
<nav
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-[1.6fr_1fr_1fr_1fr] border-t border-gold-500/30 bg-ink-950 pb-[env(safe-area-inset-bottom)] md:hidden"
  aria-label="Швидкий звʼязок"
  data-track-area="mobile_bar"
>
  <a href={contacts.phoneHref} class="flex h-16 items-center justify-center gap-1.5 bg-gold-500 text-xs font-bold tracking-wide text-ink-950 uppercase min-[400px]:text-sm">
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={phoneIcon} /></svg>
    Подзвонити
  </a>
  <a href={contacts.viber} target="_blank" rel="noopener" class="flex h-16 flex-col items-center justify-center gap-0.5 text-[11px] font-bold text-white/85">
    <svg class="h-5 w-5 text-[#9d8ff7]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={socialIcons.viber} /></svg>
    Viber
  </a>
  <a href={contacts.telegram} target="_blank" rel="noopener" class="flex h-16 flex-col items-center justify-center gap-0.5 border-l border-white/10 text-[11px] font-bold text-white/85">
    <svg class="h-5 w-5 text-[#4fb8e8]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={socialIcons.telegram} /></svg>
    Telegram
  </a>
  <a href={contacts.whatsapp} target="_blank" rel="noopener" class="flex h-16 flex-col items-center justify-center gap-0.5 border-l border-white/10 text-[11px] font-bold text-white/85">
    <svg class="h-5 w-5 text-[#4fd97f]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={socialIcons.whatsapp} /></svg>
    WhatsApp
  </a>
</nav>
