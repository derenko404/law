---
import Emblem from './Emblem.astro';
import { site } from '../data/site';

interface Props {
  /** 'light' — for dark backgrounds */
  tone?: 'light' | 'dark';
}
const { tone = 'light' } = Astro.props;
---

<a href="/" class="flex items-center gap-3" aria-label={site.name}>
  <Emblem class="h-11 w-11 shrink-0 text-gold-500" />
  <span class="flex flex-col leading-tight">
    <span
      class:list={[
        'text-sm font-800 font-extrabold tracking-wide',
        tone === 'light' ? 'text-gold-400' : 'text-gold-500',
      ]}
    >
      АБ Марина В.Г.
    </span>
    <span
      class:list={[
        'text-xs font-semibold tracking-[0.14em] uppercase',
        tone === 'light' ? 'text-gold-200' : 'text-ink-700',
      ]}
    >
      Юридичний захист
    </span>
  </span>
</a>
