---
/** Numbered pagination for collection listings. */
interface Props {
  page: {
    currentPage: number;
    lastPage: number;
    url: { prev?: string; next?: string };
  };
  /** Base path without trailing slash, e.g. '/articles' */
  base: string;
}
const { page, base } = Astro.props;

const pageUrl = (n: number) => (n === 1 ? base : `${base}/${n}`);
const pages = Array.from({ length: page.lastPage }, (_, i) => i + 1);
---

{
  page.lastPage > 1 && (
    <nav class="mt-14 flex items-center justify-center gap-2" aria-label="Сторінки">
      {page.url.prev && (
        <a
          href={page.url.prev}
          class="flex h-11 w-11 items-center justify-center border border-ink-700/20 bg-white text-body transition-colors hover:border-gold-500 hover:text-gold-500"
          aria-label="Попередня сторінка"
        >
          <svg class="h-4 w-4 rotate-180" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M2 8h11M9 4l4 4-4 4" />
          </svg>
        </a>
      )}
      {pages.map((n) =>
        n === page.currentPage ? (
          <span class="flex h-11 w-11 items-center justify-center bg-gold-500 font-bold text-ink-950" aria-current="page">
            {n}
          </span>
        ) : (
          <a
            href={pageUrl(n)}
            class="flex h-11 w-11 items-center justify-center border border-ink-700/20 bg-white font-semibold text-body transition-colors hover:border-gold-500 hover:text-gold-500"
          >
            {n}
          </a>
        ),
      )}
      {page.url.next && (
        <a
          href={page.url.next}
          class="flex h-11 w-11 items-center justify-center border border-ink-700/20 bg-white text-body transition-colors hover:border-gold-500 hover:text-gold-500"
          aria-label="Наступна сторінка"
        >
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M2 8h11M9 4l4 4-4 4" />
          </svg>
        </a>
      )}
    </nav>
  )
}
